<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Hosting Service Config</sheetTitle>
                <type>array</type>
                <el>
                    <settings.janolawservice.language>
                        <label>Sprache</label>
                        <config>
                            <type>select</type>
                            <items>
                                <numIndex index="0">
                                    <label>Deutsch</label>
                                    <value>de</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Englisch (nur in Version 3)</label>
                                    <value>gb</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Franzoesisch (nur in Version 3)</label>
                                    <value>fr</value>
                                </numIndex>
                            </items>
                            <renderType>selectSingle</renderType>
                        </config>
                    </settings.janolawservice.language>
                    <settings.janolawservice.type>
                        <label>Contenttyp</label>
                        <config>
                            <type>select</type>
                            <items>
                                <numIndex index="0">
                                    <label>AGB</label>
                                    <value>terms</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Impressum</label>
                                    <value>legaldetails</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Widerrufsbelehrung</label>
                                    <value>revocation</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>Datenschutzerklärung</label>
                                    <value>datasecurity</value>
                                </numIndex>
                                <numIndex index="4">
                                    <label>Muster-Widerrufsformular (nur in Version 3)</label>
                                    <value>model-withdrawal-form</value>
                                </numIndex>
                            </items>
                            <renderType>selectSingle</renderType>
                        </config>
                    </settings.janolawservice.type>
                    <settings.janolawservice.pdflink>
                        <label>PDF Link (nur in Version 3)</label>
                        <config>
                            <type>select</type>
                            <items>
                                <numIndex index="0">
                                    <label>kein PDF</label>
                                    <value>no_pdf</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>PDF oben</label>
                                    <value>pdf_top</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>PDF unten</label>
                                    <value>pdf_bottom</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>nur PDF Link</label>
                                    <value>only_pdf_link</value>
                                </numIndex>
                            </items>
                            <renderType>selectSingle</renderType>
                        </config>
                    </settings.janolawservice.pdflink>
                    <settings.janolawservice.shopid>
                        <label>Bitte tragen Sie hier die Shop ID ein, falls diese von der
                            zentral eingestellen Shop ID abweicht
                        </label>
                        <config>
                            <type>input</type>
                        </config>
                    </settings.janolawservice.shopid>
                    <settings.janolawservice.userid>
                        <label>Bitte tragen Sie hier die User ID ein, falls diese von der
                            zentral eingestellen User ID abweicht
                        </label>
                        <config>
                            <type>input</type>
                        </config>
                    </settings.janolawservice.userid>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
